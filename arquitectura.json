    {
      "termino": "Cheques Colón",
      "significado": "Pagos de la Clínica Colón que se reparten entre profesionales; se depositan por fecha."
    },
    {
      "termino": "CPSM",
      "significado": "Aporte del 5% (Labayen exento); también marca el 2º aporte de capital financiado con préstamo."
    },
    {
      "termino": "Gastos A",
      "significado": "Gastos comunes del mes cubiertos con cheques/OSDE y descontados a cada profesional."
    },
    {
      "termino": "Retención Ganancias",
      "significado": "Porcentaje retenido (15% desde Ago 2026) para cubrir vencimientos de Ganancias."
    },
    {
      "termino": "Préstamos Casa",
      "significado": "Cuotas de préstamos de la obra; los CPSM (Principal, León, Mazzola) financian el 2º aporte; los demás (ej. Mercadolibre) suman como aporte."
    },
    {
      "termino": "Fondo CEOT / Ayudantía cruzada",
      "significado": "Fondo común que compensa ayudantías entre profesionales."
    },
    {
      "termino": "REDSOM",
      "significado": "Prestador cuyas liquidaciones y siniestros se siguen por paciente."
    },
    {
      "termino": "DLA",
      "significado": "PDF mensual 'Detalle de Liquidación de Cuenta' de la clínica."
    }
  ]
