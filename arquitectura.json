{
  "app": "CEOT — Panel Admin y Portal Profesional",
  "descripcion": "Aplicación web de una sola página (sin build) para CEOT, clínica de traumatología de Mar del Plata. Liquida honorarios, cheques y gastos de los profesionales, lleva la administración de la casa/obra y muestra a cada profesional su portal con netos mes a mes.",
  "version": "2026-11-23-convenios-portal",
  "generado": "2026-11-23",
  "hosting": {
    "tipo": "GitHub Pages (estático)",
    "repo": "Febo983/ceot-admin-panel",
    "rama_publicada": "master",
    "url": "https://febo983.github.io/ceot-admin-panel/",
    "build": "Ninguno: lo que está en master es lo que se sirve",
    "cache_busting": "version.txt + CURRENT_BUILD en index.html + ?v= en cada <script src> local (tools/bump.mjs). La página consulta version.txt y avisa cuando hay versión nueva."
  },
  "capas": [
    {
      "id": "usuarios",
      "nombre": "Usuarios",
      "items": [
        "Admin (Marcelo)",
        "Profesionales / socios (portal)"
      ]
    },
    {
      "id": "frontend",
      "nombre": "Navegador — index.html + js/*.js",
      "items": [
        "Login y sesión (token)",
        "Panel Admin (sidenav + home de accesos)",
        "Portal Profesional (pestañas por mes)",
        "Cálculos compartidos (netos, cheques, sueldo director)"
      ]
    },
    {
      "id": "estado",
      "nombre": "Estado local",
      "items": [
        "localStorage (claves ceot_*, deb_*, redsom_*, conc_*)",
        "Datos semilla en el código (js/datos.js, gastos-casa.js, estadisticas-datos.js, nun-data.js)"
      ]
    },
    {
      "id": "backend",
      "nombre": "Backend — Google Apps Script",
      "items": [
        "Liquidación (login, nómina, importación)",
        "Sync (clave/valor entre PCs)",
        "Gastos A",
        "Cirugías",
        "Cajas",
        "Licencias",
        "Buzón (Gmail)"
      ]
    },
    {
      "id": "externos",
      "nombre": "Servicios externos",
      "items": [
        "Google Sheets / Drive / Gmail (detrás de Apps Script)",
        "Cloudflare Worker: auditor de débitos",
        "Google Calendar (embed)",
        "corsproxy.io (presentación)",
        "CDNs: jsPDF, html2canvas, SheetJS, pdf.js, Chart.js, Lucide"
      ]
    }
  ],
  "flujos": [
    {
      "id": "login",
      "nombre": "Login",
      "pasos": [
        "Usuario + clave en loginView",
        "GET LIQUIDACION_ENDPOINT?action=login",
        "Respuesta { ok, token, role: admin | profesional }",
        "entrarConSesion(): carga Gastos A, liquidación, % aporte, aportes cerrados y nómina en paralelo",
        "role=admin → adminView · si no → portal del profesional (DOCTORES)",
        "Sesión guardada en ceot_sesion; restaurarSesion() la reusa tras F5"
      ]
    },
    {
      "id": "sync",
      "nombre": "Sincronización entre PCs",
      "pasos": [
        "El módulo guarda en localStorage",
        "syncPush(clave): POST text/plain a SYNC_ENDPOINT { accion:set, clave, valor, token } (solo admin; un envío por clave a la vez, fallback JSONP)",
        "syncPull(clave): JSONP desde SYNC_ENDPOINT, reemplaza lo local y repinta",
        "Lo que no está en el servidor arranca desde la semilla del código"
      ]
    },
    {
      "id": "liquidacion",
      "nombre": "Liquidación mensual",
      "pasos": [
        "abrirImportModal(): pegar/subir Excel o CSV de la clínica",
        "Parseo + MAPE_MAP + validación + vista previa",
        "Guarda en Apps Script (action=import) con respaldo previo (action=leer)",
        "Efectos secundarios: registros REDSOM y Débitos",
        "Admin: Liquidaciones del mes, CPSM, Total CEOT, Transferencias del Mes",
        "Portal: renderIndividual() calcula neto y cheques de cada profesional"
      ]
    },
    {
      "id": "publicar",
      "nombre": "Publicación",
      "pasos": [
        "node tools/bump.mjs <nombre>",
        "node tools/preflight.mjs (conflictos, sintaxis, versión)",
        "Harness de regresión opcional (tools/regression)",
        "git push a master → GitHub Pages"
      ]
    }
  ],
